# Environment variables for VideoShorts
# Copy this to .env and fill in your values. NEVER commit .env itself.

# ── LLM providers (supply the one(s) you use) ──────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
QWEN_API_KEY=your_qwen_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── AutoClip settings ───────────────────────────────────────────────────────
# Path to the autoclip executable inside the separate venv
AUTOCLIP_BIN=../autoclip-venv/Scripts/autoclip.exe

# Default LLM provider passed to autoclip
AUTOCLIP_PROVIDER=gemini

# ── App settings ────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./videoshorts.db
OUTPUTS_DIR=./outputs
HOST=127.0.0.1
PORT=8000
DEBUG=true
